{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capabilities for the main Ogmara window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-position",
    "core:window:allow-outer-position",
    "notification:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "shell:allow-open",
    "clipboard-manager:allow-read-image",
    "clipboard-manager:allow-read-text",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    "window-state:default",
    "window-state:allow-restore-state",
    "window-state:allow-save-window-state",
    {
      "identifier": "http:default",
      "comment": "audit 2026-06-07 B4.6/W2: node URLs are user-configurable so https on any host/port stays open, but arbitrary PLAINTEXT http:// is dropped (TLS enforced, matching the SSRF/host-binding fixes). Plaintext is allowed ONLY for loopback (local dev node).",
      "allow": [
        { "url": "https://*:*" },
        { "url": "https://*" },
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" }
      ]
    }
  ]
}
